{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "noEmit": true,
        "types": [
            "react"
        ],
        "paths": {
            "@/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "./src/**/*.ts",
        "./src/**/*.tsx"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}