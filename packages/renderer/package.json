{
  "name": "@resume/renderer",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build:css": "mkdir -p dist && tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "watch:css": "mkdir -p dist && tailwindcss -i ./src/styles.css -o ./dist/styles.css --watch"
  },
  "exports": {
    ".": "./src/ResumeRenderEngine.tsx",
    "./constants": "./src/constants.ts",
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@resume/backend": "workspace:*",
    "@resume/frontend": "workspace:*",
    "@resume/theme": "workspace:*",
    "@tailwindcss/cli": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "react-colorful": "^5.8.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
  }
}